# ===============================================
# WORKIVO 2.0 - CLOUD CONFIGURATION (.env.local)
# ===============================================

# --- SUPABASE CONFIGURATION (Database & Auth) ---
# Obtain from your Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AWS CONFIGURATION (S3 Media Storage & APIs) ---
# Obtain from AWS IAM > User Security Credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=workivo-media-storage